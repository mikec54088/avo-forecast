<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.avoforecast.kalshi-research-run</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/hermesagent/miniconda3/bin/uv</string>
        <string>run</string>
        <string>python</string>
        <string>-m</string>
        <string>experiments.kalshi_research.runner</string>
        <string>run</string>
        <string>--source</string>
        <string>full</string>
        <string>--researcher</string>
        <string>claude</string>
        <string>--model</string>
        <string>claude-sonnet-5</string>
        <string>--max-close-hours</string>
        <string>120</string>
        <string>--final-hours</string>
        <string>1</string>
        <string>--max-markets</string>
        <string>50000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/hermesagent/development/avo-forecast</string>

    <!-- The forward pass for kalshi_research (docs/PLAN-2026-09-09.md, B4).
         Reads the hourly FULL snapshot (lands ~:40) at :50, so quotes are
         <=10 min old at the pass and <=60 min old at capture. The full pass,
         not the near one: major-league game markets carry a close_time 2-3
         days after the game and never enter the <=24h near window (measured
         2026-09-09: 0 of 1,505 near-pass rows). Zero API calls; research
         cost is incurred only by candidates that call context.research. The
         control never does, so with the control alone this spends nothing
         and simply starts the log's clock.

         --model is PINNED, not left to the CLI default. Two reasons: the
         default was Fable and its credits ran out, which silently turned every
         research call into an error (2026-09-10); and INVARIANT #7 makes the
         researcher part of the experimental setup -- forecasts researched by
         different models are not comparable, and the model is recorded per row
         in the forecast log's `researcher` column. Sonnet 5 because the task
         is retrieval and grounded summarisation, not reasoning: the prompt
         forbids the researcher from offering a probability, and the mapping
         from findings to a forecast lives in the candidate. Cost also scales
         with market count, which the generating agent's does not. -->
    <key>StartCalendarInterval</key>
    <dict><key>Minute</key><integer>50</integer></dict>

    <key>StandardOutPath</key>
    <string>/Users/hermesagent/development/avo-forecast/data/research.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hermesagent/development/avo-forecast/data/research.log</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>

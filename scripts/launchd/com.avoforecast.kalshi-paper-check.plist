<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.avoforecast.kalshi-paper-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/hermesagent/miniconda3/bin/uv</string>
        <string>run</string>
        <string>python</string>
        <string>-m</string>
        <string>experiments.kalshi_quant.paper_check</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/hermesagent/.local/bin:/Users/hermesagent/miniconda3/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/hermesagent/development/avo-forecast</string>

    <!-- WHY. The backtest and paper trading disagreed for eleven days
         (2026-09-17..28) before anyone compared them; the backtest's entry
         rule used hindsight. This compares them daily on the same markets and
         prints "!!! ALARM" when their decisions or their money diverge.

         02:45: after the 02:00 entries build, so the replay covers last
         night's resolutions.

         Verify:  grep ALARM data/paper-check.log -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>2</integer>
        <key>Minute</key><integer>45</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/hermesagent/development/avo-forecast/data/paper-check.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hermesagent/development/avo-forecast/data/paper-check.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>

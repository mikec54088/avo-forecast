<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.avoforecast.kalshi-snapshot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/hermesagent/miniconda3/bin/uv</string>
        <string>run</string>
        <string>python</string>
        <string>-m</string>
        <string>experiments.kalshi_quant.capture</string>
        <string>snapshot</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/hermesagent/development/avo-forecast</string>

    <!-- The full pass: every open market, hourly at :07. Was every 20 min
         until 2026-08-25, when the universe hit 2.12M markets and a sweep took
         941s against a 1200s slot -- 78% of the ceiling, climbing ~50k markets
         per sweep.

         Pacing is not a lever: page cost is max(pace, latency) and latency is
         ~0.444s, so the sweep is latency-bound at ~2.25 req/s no matter what
         MIN_REQUEST_INTERVAL says. The only lever is fewer pages.

         Hourly moves this from 78% of its slot to ~26%, raising the ceiling
         from 2.7M to 8.1M markets, and cuts daily request volume from ~152k
         pages to ~52k. Near-close resolution is not lost -- it improves, and
         moves to the -near agent, which runs every 15 min at 3s a pass.
         What this pass preserves is long-horizon price history (now hourly
         rather than 20-minutely) and a backstop if max_close_ts ever changes
         meaning.

         StartInterval is deliberately not used: it is a relative timer that
         macOS coalesces, and observed gaps were 21m28s against a nominal
         900s. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>7</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/hermesagent/development/avo-forecast/data/capture.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hermesagent/development/avo-forecast/data/capture.log</string>

    <!-- Also sweep on load/boot rather than waiting up to 15 min for a tick. -->
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>

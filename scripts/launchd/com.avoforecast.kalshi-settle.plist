<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.avoforecast.kalshi-settle</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/hermesagent/miniconda3/bin/uv</string>
        <string>run</string>
        <string>python</string>
        <string>-m</string>
        <string>experiments.kalshi_quant.capture</string>
        <string>settle</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/hermesagent/development/avo-forecast</string>

    <!-- Hourly at :52. Moved from :12 on 2026-08-25 when the full sweep went
         hourly at :07 and now occupies roughly :07-:23 (longer as the universe
         grows). :52 stays clear of it. The 3-second -near passes on the
         quarter hour are too short to matter either way.
         settle is cheap (145 requests / 35s on first run, 40 / 10s when little
         is pending) and idempotent, so a missed run costs nothing. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>52</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/hermesagent/development/avo-forecast/data/capture.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hermesagent/development/avo-forecast/data/capture.log</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Kalshi public trade tape (scripts/trade_tape.py), for measuring resting-order
     fills. Hourly at :20; each run fetches the last 6 COMPLETE hours it does not
     already have (~75 s per hour of tape), so a missed run heals itself. -->
<dict>
    <key>Label</key>
    <string>com.avoforecast.trade-tape</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/hermesagent/miniconda3/bin/uv</string>
        <string>run</string>
        <string>python</string>
        <string>scripts/trade_tape.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict><key>PATH</key><string>/Users/hermesagent/.local/bin:/Users/hermesagent/miniconda3/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
    <key>WorkingDirectory</key>
    <string>/Users/hermesagent/development/avo-forecast</string>
    <key>StartCalendarInterval</key>
    <dict><key>Minute</key><integer>20</integer></dict>
    <key>StandardOutPath</key>
    <string>/Users/hermesagent/development/avo-forecast/data/trade-tape.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hermesagent/development/avo-forecast/data/trade-tape.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
